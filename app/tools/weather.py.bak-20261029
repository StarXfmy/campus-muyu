"""天气：Open-Meteo（免费、无需 key），带今日高低温、降水概率和未来 24 小时。

以前用 HDUHelp 的 feed 聚合项，只有当前那一格、没有预报，
问「明天」只能回「查不到」。换成 Open-Meteo 后这些都有。
坐标默认杭电绍兴校区，可用 .env 覆盖。

校园网到 api.open-meteo.com 的冷连接不稳（实测一次等满 12 秒还超时），
所以这里 10 分钟缓存 + 5 秒超时 + 失败后台预热：
慢的那一次降级作答，成功结果进缓存，下次问就是秒回。
"""
from __future__ import annotations

import json
import os
import re
import threading
import time
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

DEFAULT_LAT, DEFAULT_LON, DEFAULT_NAME = 30.002, 120.579, "绍兴"

CITY_NAME = os.getenv("WEATHER_CITY_NAME", DEFAULT_NAME)
LAT = float(os.getenv("WEATHER_LAT", str(DEFAULT_LAT)))
LON = float(os.getenv("WEATHER_LON", str(DEFAULT_LON)))

# 内置坐标：问「杭州天气」就查杭州，没点名就用默认（绍兴校区）
CITIES: dict[str, tuple[float, float]] = {
    "绍兴": (30.002, 120.579),
    "杭州": (30.290, 120.160),
    "宁波": (29.870, 121.550),
    "上海": (31.230, 121.470),
    "北京": (39.900, 116.410),
    "广州": (23.130, 113.260),
    "成都": (30.670, 104.070),
    "深圳": (22.540, 114.060),
    "南京": (32.060, 118.800),
    "武汉": (30.590, 114.310),
    "西安": (34.340, 108.940),
}


def pick_city(text: str = "") -> str:
    """从一句话里认出城市名，认不出就用默认城市。"""
    for name in CITIES:
        if name in (text or ""):
            return name
    return CITY_NAME


# 内置表只有常问的几个；其余城市走 Open-Meteo 的免费地名解析（无需 key）
_GEO_URL = "https://geocoding-api.open-meteo.com/v1/search"

_PROVINCES = (
    "黑龙江", "内蒙古", "新疆", "西藏", "宁夏", "广西", "吉林", "辽宁", "河北", "河南",
    "山东", "山西", "陕西", "甘肃", "青海", "江苏", "浙江", "安徽", "福建", "江西",
    "湖北", "湖南", "广东", "海南", "四川", "贵州", "云南",
    "北京", "天津", "上海", "重庆", "香港", "澳门", "台湾",
)

# 从一句话里剥掉这些词，剩下的当城市名去查
_NOISE = (
    "大后天", "今天", "明天", "后天", "昨天", "前天", "现在", "这周", "下周", "周末",
    "上午", "下午", "晚上", "早上", "中午", "夜里",
    "天气", "气温", "温度", "预报", "怎么样", "如何", "多少度", "几度",
    "冷不冷", "热不热", "下雨", "下雪", "会不会", "有没有",
    "查一下", "帮我", "问一下", "看看", "那边", "这里", "那里",
    "想知道", "想看", "我要", "我想", "我",
    "去", "到", "在", "想",
    "的", "呢", "吗", "啊", "呀", "吧", "查", "看",
)

_GEO_CACHE: dict[str, dict] = {}
_GEO_FAILED_AT: dict[str, float] = {}

# 这些字出现在候选词里，八成是在问「好不好」而不是地名
_NOT_PLACE = ("好", "吗", "呢", "怎", "么", "啥", "呀", "啊", "吧")

_DIRECT_CITIES = ("北京", "上海", "天津", "重庆")
_ADMIN_WORDS = ("壮族自治区", "维吾尔自治区", "回族自治区", "特别行政区", "自治区", "省", "市")


def _strip_admin(text: str) -> str:
    changed = True
    while changed:
        changed = False
        for word in _ADMIN_WORDS:
            if text.startswith(word):
                text = text[len(word):]
                changed = True
                break
    return text


def _place_candidates(key: str) -> list[str]:
    """按行政级别拆出候选，从最可能命中的开始查。

    兼容「佳木斯」「佳木斯市」「黑龙江佳木斯」「黑龙江省佳木斯市」
    「杭州市西湖区」「北京市朝阳区」这些写法。
    """
    out: list[str] = []
    rest = key
    for province in _PROVINCES:
        if rest.startswith(province):
            tail = rest[len(province):]
            if province in _DIRECT_CITIES:
                out.append(province)  # 北京市朝阳区 → 先查北京
            rest = _strip_admin(tail)
            break

    match = re.match(r"^(.{2,8}?市)", rest)
    if match:
        out.append(match.group(1)[:-1])  # 杭州市 → 杭州
        rest = rest[len(match.group(1)):]
        out.append(match.group(1))  # 杭州市

    if rest:
        out.append(rest)
    out.append(key)

    area = re.search(r"([^省市]{2,6}?[区县])", key)
    if area and "自治区" not in area.group(1):
        out.append(area.group(1))
        out.append(area.group(1)[:-1])

    return [c for c in dict.fromkeys(c.strip() for c in out) if c][:4]


def _guess_place(text: str) -> str:
    """把「明天黑龙江佳木斯天气」剥成「黑龙江佳木斯」。"""
    rest = text or ""
    for word in _NOISE:
        rest = rest.replace(word, "")
    rest = rest.strip(" ，,。.！!？?、:：")
    return rest if 1 < len(rest) <= 16 else ""


def _geo_request(name: str) -> dict | None:
    url = f"{_GEO_URL}?name={urllib.parse.quote(name)}&count=1&language=zh&format=json"
    try:
        with urllib.request.urlopen(url, timeout=4) as response:
            data = json.loads(response.read().decode("utf-8"))
    except Exception:
        return None
    hits = data.get("results") or []
    if not hits:
        return None
    hit = hits[0]
    lat, lon = hit.get("latitude"), hit.get("longitude")
    if not isinstance(lat, (int, float)) or not isinstance(lon, (int, float)):
        return None
    return {
        "name": str(hit.get("name") or name),
        "lat": float(lat),
        "lon": float(lon),
        "admin": str(hit.get("admin1") or ""),
    }


def _geocode(name: str) -> dict | None:
    """城市名 → 坐标。支持「黑龙江佳木斯」这种带省名的写法。"""
    key = (name or "").strip()
    if not key:
        return None
    if key in _GEO_CACHE:
        return _GEO_CACHE[key]
    if time.time() - _GEO_FAILED_AT.get(key, 0) < 60:
        return None

    # 候选顺序见 _place_candidates：市名 > 去省份 > 原词 > 区县 > 尾部截短。
    # 不试两个字的地名——「木斯」这种小镇会抢在「佳木斯」前面命中。
    for candidate in _place_candidates(key):
        if candidate in _GEO_CACHE:
            found = _GEO_CACHE[candidate]
            _GEO_CACHE[key] = found
            return found
        found = _geo_request(candidate)
        if found:
            # 命中的那个写法也记下来，「佳木斯」和「黑龙江佳木斯」共用一份结果
            _GEO_CACHE[key] = found
            _GEO_CACHE[candidate] = found
            _GEO_FAILED_AT.pop(key, None)
            return found
    _GEO_FAILED_AT[key] = time.time()
    return None


def _display_name(name: str) -> str:
    """「佳木斯市」→「佳木斯」，显示时不用带行政级别。"""
    value = (name or "").strip()
    if len(value) > 2 and value.endswith("市"):
        return value[:-1]
    return value


def resolve(text: str = "") -> dict:
    """从一句话里认出要查的城市，返回名字和坐标。

    认不出就用默认城市（绍兴校区）。local=True 表示本地站，可以挂 AQI；
    unknown=True 表示用户点名了一个地方但没查到，别拿默认城市糊弄。
    """
    for name in CITIES:
        if name in (text or ""):
            return {
                "name": name,
                "lat": CITIES[name][0],
                "lon": CITIES[name][1],
                "local": name == CITY_NAME,
            }
    guess = _guess_place(text)
    if guess and not any(ch in guess for ch in _NOT_PLACE):
        found = _geocode(guess)
        if found:
            return {
                "name": _display_name(found["name"]),
                "lat": found["lat"],
                "lon": found["lon"],
                "local": False,
            }
        return {"name": guess, "lat": LAT, "lon": LON, "local": False, "unknown": True}
    return {"name": CITY_NAME, "lat": LAT, "lon": LON, "local": True}

# WMO 天气代码 → 中文
WMO = {
    0: "晴", 1: "大致晴", 2: "多云", 3: "阴", 45: "雾", 48: "雾凇",
    51: "毛毛雨", 53: "毛毛雨", 55: "毛毛雨", 56: "冻毛毛雨", 57: "冻毛毛雨",
    61: "小雨", 63: "中雨", 65: "大雨", 66: "冻雨", 67: "冻雨",
    71: "小雪", 73: "中雪", 75: "大雪", 77: "雪粒",
    80: "阵雨", 81: "阵雨", 82: "强阵雨", 85: "阵雪", 86: "阵雪",
    95: "雷雨", 96: "雷雨伴冰雹", 99: "雷雨伴冰雹",
}

_TIMEOUT = 5
_CACHE_TTL = 10 * 60  # 天气预报 10 分钟内不会变
_FAIL_COOLDOWN = 60  # 刚失败过就先走兜底，别让下一条消息再等 5 秒

_CACHE: dict[str, tuple[float, dict]] = {}
_FAILED_AT: dict[str, float] = {}
_WARMING: set[str] = set()
_LOCK = threading.Lock()


def _cache_get(name: str) -> dict | None:
    with _LOCK:
        item = _CACHE.get(name)
    if item and time.time() - item[0] <= _CACHE_TTL:
        return item[1]
    return None


def _cache_put(name: str, data: dict) -> None:
    with _LOCK:
        _CACHE[name] = (time.time(), data)
        _FAILED_AT.pop(name, None)


def _mark_failed(name: str) -> None:
    with _LOCK:
        _FAILED_AT[name] = time.time()


def _recently_failed(name: str) -> bool:
    with _LOCK:
        at = _FAILED_AT.get(name)
    return bool(at) and time.time() - at < _FAIL_COOLDOWN


def _warm(name: str, url: str) -> None:
    """后台补一次；成功就进缓存，下次问就是秒回。"""
    with _LOCK:
        if name in _WARMING:
            return
        _WARMING.add(name)

    def run() -> None:
        try:
            data = _parse(_fetch(url), name)
            if data.get("ok"):
                _cache_put(name, data)
        except Exception:
            pass
        finally:
            with _LOCK:
                _WARMING.discard(name)

    threading.Thread(target=run, daemon=True, name=f"weather-warm-{name}").start()


def _fetch(url: str) -> dict:
    request = urllib.request.Request(
        url, headers={"User-Agent": "campus-assistant/1.0", "Accept": "application/json"}
    )
    with urllib.request.urlopen(request, timeout=_TIMEOUT) as response:
        return json.loads(response.read().decode("utf-8"))


def _parse(data: dict, name: str) -> dict:
    current = data.get("current_weather") or {}
    if not isinstance(current.get("temperature"), (int, float)):
        return {"ok": False, "reason": "数据不完整"}

    daily = data.get("daily") or {}
    hourly = data.get("hourly") or {}

    def _pick(seq, index):
        try:
            return seq[index]
        except (KeyError, IndexError, TypeError):
            return None

    maxes = daily.get("temperature_2m_max") or []
    mins = daily.get("temperature_2m_min") or []
    pops = daily.get("precipitation_probability_max") or []
    codes = daily.get("weathercode") or []

    today = {
        "max": round(_pick(maxes, 0)) if isinstance(_pick(maxes, 0), (int, float)) else None,
        "min": round(_pick(mins, 0)) if isinstance(_pick(mins, 0), (int, float)) else None,
        "pop": _pick(pops, 0),
        "text": WMO.get(_pick(codes, 0), ""),
    }
    tomorrow = {
        "max": round(_pick(maxes, 1)) if isinstance(_pick(maxes, 1), (int, float)) else None,
        "min": round(_pick(mins, 1)) if isinstance(_pick(mins, 1), (int, float)) else None,
        "pop": _pick(pops, 1),
        "text": WMO.get(_pick(codes, 1), ""),
    }

    hours: list[dict] = []
    times = hourly.get("time") or []
    if times:
        # 从「下一个整点」开始列：20:13 时 20:00 这一格已经过去了，
        # 再列出来就是拿过去当未来。当前温度上面 head 已经写过了。
        now_key = (datetime.now(timezone(timedelta(hours=8))) + timedelta(hours=1)).strftime(
            "%Y-%m-%dT%H"
        )
        start = 0
        for index, stamp in enumerate(times):
            if str(stamp)[:13] >= now_key:
                start = index
                break
        temps = hourly.get("temperature_2m") or []
        h_codes = hourly.get("weathercode") or []
        h_pops = hourly.get("precipitation_probability") or []
        for index in range(start, min(start + 6, len(times))):
            stamp = str(times[index])
            temp = _pick(temps, index)
            hours.append(
                {
                    "time": stamp[11:16],
                    "temp": round(temp) if isinstance(temp, (int, float)) else None,
                    "text": WMO.get(_pick(h_codes, index), ""),
                    "pop": _pick(h_pops, index),
                }
            )

    return {
        "ok": True,
        "city": name,
        "temp": round(float(current["temperature"]), 1),
        "text": WMO.get(current.get("weathercode"), ""),
        "today": today,
        "tomorrow": tomorrow,
        "hours": hours,
    }


def fetch(city: str | dict = "") -> dict:
    """一次取全。city 可以是整句话、城市名或 resolve() 的结果。

    resolve() 的结果直接传进来，避免二次解析——之前「佳木斯市」再解析一次
    失败会静默回落到绍兴，等于拿错城市的数据。
    """
    if isinstance(city, dict):
        name, lat, lon = city["name"], city["lat"], city["lon"]
    else:
        place = resolve(city)
        name, lat, lon = place["name"], place["lat"], place["lon"]

    hit = _cache_get(name)
    if hit:
        return hit
    if _recently_failed(name):
        return {"ok": False, "reason": "刚失败过"}

    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}"
        "&current_weather=true&timezone=Asia%2FShanghai&forecast_days=2"
        "&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,weathercode"
        "&hourly=temperature_2m,weathercode,precipitation_probability"
    )
    try:
        data = _parse(_fetch(url), name)
    except Exception as exc:
        _mark_failed(name)
        _warm(name, url)
        return {"ok": False, "reason": f"{type(exc).__name__}"}
    if not data.get("ok"):
        _mark_failed(name)
        return data
    _cache_put(name, data)
    return data
