# 从飞书开放平台「凭证与基础信息」复制
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# hduhelp-cli 路径（默认已装在这里，一般不用改）
HDUHELP_CLI=C:\path\to\hduhelp-cli.exe
CLI_TIMEOUT=25

# 功能模型：查校园数据后的措辞/点评，以及联网搜索接口（智谱）
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_TIMEOUT=15

# 聊天模型：闲聊和自由对话。不填就用上面的 LLM_*
# 接 DeepSeek：CHAT_API_KEY=sk-xxx / CHAT_MODEL=deepseek-flash / CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=
CHAT_MODEL=glm-4-air
CHAT_BASE_URL=

# 空教室缓存范围：楼栋号用逗号分隔
CACHE_BUILDINGS=ZX,CZ,QY
